# NextAuth (Auth.js) - generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB connection string used by Prisma
DATABASE_URL=

# Cloudinary — handles every upload (images, attachments) and hosts the course
# videos, replacing UploadThing and Mux.
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Who may open /teacher (id, or a comma-separated email list)
NEXT_PUBLIC_TEACHER_ID=
NEXT_PUBLIC_TEACHER_EMAILS=

# Where students send the course fee, shown on the purchase popup.
VODAFONE_CASH_NUMBER=
INSTAPAY_NUMBER=
INSTAPAY_HANDLE=
SUPPORT_PHONE=

# Public origin, for absolute Open Graph/icon URLs (falls back to NEXTAUTH_URL).
NEXT_PUBLIC_SITE_URL=
